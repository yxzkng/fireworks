# Vercel 대시보드 > Settings > Environment Variables 에 등록하세요.
# .env 파일을 커밋하지 마세요.

# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr)
SEOUL_API_KEY=

# 서울 열린데이터광장 "실시간 지하철" 인증키 (일반 인증키와 별도 발급)
SEOUL_SUBWAY_KEY=

# Cron 엔드포인트 보호용. 아무 긴 문자열이면 됩니다.
CRON_SECRET=

# 아래 3개는 브라우저에 노출되는 공개 값입니다.
# 카카오 개발자센터 JavaScript 키 (https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_KEY=
# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
